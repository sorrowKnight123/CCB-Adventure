[internationalization]

locale/translations_pot_files=PackedStringArray("res://dialogues/demo.dialogue", "res://dialogues/game.dialogue", "res://dialogues/clues.dialogue")

[layer_names]

2d_physics/layer_1="collision"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="magic_collision"
2d_physics/layer_5="platform"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
